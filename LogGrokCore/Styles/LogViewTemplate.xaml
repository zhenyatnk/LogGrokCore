<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:LogGrokCore"
                    xmlns:localControls="clr-namespace:LogGrokCore.Controls"
                    xmlns:mahapps="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:listControls="clr-namespace:LogGrokCore.Controls.ListControls"
                    xmlns:virtualizingStackPanel1="clr-namespace:LogGrokCore.Controls.ListControls.VirtualizingStackPanel"
                    xmlns:textRender="clr-namespace:LogGrokCore.Controls.TextRender"
                    mc:Ignorable="d">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/styles/controls.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/styles/controls.contextmenu.xaml" />
        <ResourceDictionary Source="ListViewItemStyle.xaml" />
        <ResourceDictionary Source="LogViewContextMenu.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="LogViewTemplate" DataType="local:LogViewModel">
        <Grid localControls:RoutedCommandBehavior.RoutedCommandToCommandBinding= "{localControls:RoutedCommandToCommandBinding 
                RoutedCommand={x:Static local:RoutedCommands.ClearFilters}, 
                Command={Binding ClearFiltersCommand}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0"
                        Margin="4,2,4,2"
                        Orientation="Horizontal"
                        Visibility="{Binding HaveExclusions,
                                    Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding ActiveFilters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2"
                                    Padding="6,1"
                                    Background="#22808080"
                                    BorderBrush="#40808080"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="11"
                                               Text="{Binding DisplayText}" />
                                    <Button Margin="4,0,0,0"
                                            Padding="2,0"
                                            Command="{Binding RemoveCommand}"
                                            Content="&#x2715;"
                                            FontSize="10"
                                            Style="{StaticResource MahApps.Styles.Button.Chromeless}"
                                            ToolTip="Remove filter" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Margin="4,2,0,2"
                        Padding="6,1"
                        Command="{Binding ClearExclusionsCommand}"
                        Content="Clear all"
                        FontSize="11"
                        Style="{StaticResource MahApps.Styles.Button.Chromeless}"
                        ToolTip="Clear all filters" />
            </StackPanel>
            <mahapps:MetroProgressBar
                Grid.Row="1"
                Height="3"
                HorizontalAlignment="Stretch"
                Value="{Binding Progress}"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <localControls:LogMinimapControl Grid.Row="2"
                                             Height="30"
                                             HorizontalAlignment="Stretch"
                                             ClipToBounds="True"
                                             ItemCount="{Binding TotalLineCount}"
                                             Markers="{Binding Markers}"
                                             MatchBuckets="{Binding SearchMatches}"
                                             IsRangeEnabled="{Binding TimeRangeFilter.IsAvailable}"
                                             Minimum="{Binding TimeRangeFilter.Minimum,
                                                        Mode=OneWay}"
                                             Maximum="{Binding TimeRangeFilter.Maximum,
                                                        Mode=OneWay}"
                                             LowerValue="{Binding TimeRangeFilter.LowerValue,
                                                          Mode=TwoWay}"
                                             UpperValue="{Binding TimeRangeFilter.UpperValue,
                                                          Mode=TwoWay}"
                                             MinText="{Binding TimeRangeFilter.MinText}"
                                             MaxText="{Binding TimeRangeFilter.MaxText}"
                                             DurationText="{Binding TimeRangeFilter.DurationText}"
                                             ScrollPosition="{Binding ScrollPosition}"
                                             ScrollIndicatorBrush="#FF00C853"
                                             MatchLine="{Binding SearchMatchLine}"
                                             MatchLineBrush="#FFFF00FF"
                                             MarkerBrush="#FFE81123"
                                             MatchBrush="#A0F2A900"
                                             MinimapBackground="{DynamicResource MahApps.Brushes.Control.Background}"
                                             SelectionBrush="#33007ACC"
                                             DimBrush="#40000000"
                                             HandleBrush="#FF007ACC"
                                             DurationForeground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                             DurationBackground="{DynamicResource MahApps.Brushes.ThemeBackground}"
                                             NavigateCommand="{Binding NavigateToMarkerCommand}"
                                             ToolTip="Timeline: drag the handles to filter by time; Ctrl+drag the selection to move it; click to navigate" />
            <Grid Grid.Row="3">
            <listControls:ListView ItemsSource="{Binding Lines}"
                                    SelectionMode="Extended"
                                    ReadonlySelectedItems="{Binding SelectedItems,
                                                            Mode=OneWayToSource}"
                                    View="{Binding CustomView}"
                                    ItemContainerStyle="{StaticResource ItemContainerStyle}"
                                    ScrollViewer.VerticalScrollBarVisibility="Visible"
                                    ScrollViewer.CanContentScroll="True"
                                    VirtualizingStackPanel.IsVirtualizing="True"
                                    VirtualizingStackPanel.VirtualizationMode="Recycling"   
                                    localControls:NavigateToLineBehavior.NavigateToLineRequest=
                                        "{Binding NavigateToLineRequest}"
                                    localControls:NavigateToLineBehavior.ChangeCurrentItem="True"
                                    FontFamily="{StaticResource JetBrainsMono}"
                                    ColumnSettings="{Binding ColumnSettings}"
                                    x:Name="ItemsListView">
                <textRender:TextView.SharedFoldingState>
                    <textRender:TextViewSharedFoldingState/>
                </textRender:TextView.SharedFoldingState>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <virtualizingStackPanel1:VirtualizingStackPanel
                            CurrentPosition="{Binding CurrentItemIndex}" 
                            FirstVisibleIndex="{Binding FirstVisibleIndex}"
                            textRender:TextView.HighlightRegex="{Binding HighlightRegex}"
                            Tag="{Binding 
                                RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type listControls:ListView}}}"
                            ContextMenu="{StaticResource LogViewContextMenu}" 
                            textRender:ClippingRectProviderBehavior.ClippingRectProvider="{Binding RelativeSource={RelativeSource Self}}"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </listControls:ListView>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>